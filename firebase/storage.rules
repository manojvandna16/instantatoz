rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================
    // Helper functions
    // =========================================================
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Max file size: 5 MB
    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Max file size: 10 MB (for documents)
    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Allowed image types
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|heic)');
    }

    // Allowed document types
    function isDocument() {
      return request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('image/(jpeg|jpg|png)');
    }

    // =========================================================
    // Worker profile photos: /workers/{workerId}/profile.*
    // =========================================================
    match /workers/{workerId}/profile/{fileName} {
      // Authenticated users can view worker profile photos (for job matching UI)
      allow read: if isAuth();
      // Only the worker can upload their own profile photo
      allow write: if isOwner(workerId)
        && isImage()
        && isUnder5MB();
      allow delete: if isOwner(workerId);
    }

    // =========================================================
    // Worker verification documents: /workers/{workerId}/documents/*
    // =========================================================
    match /workers/{workerId}/documents/{fileName} {
      // Only the worker can read their own documents
      allow read: if isOwner(workerId);
      // Worker can upload their own documents (ID, certificates)
      allow write: if isOwner(workerId)
        && isDocument()
        && isUnder10MB();
      allow delete: if isOwner(workerId);
    }

    // =========================================================
    // User profile photos: /users/{userId}/profile.*
    // =========================================================
    match /users/{userId}/profile/{fileName} {
      allow read: if isAuth();
      allow write: if isOwner(userId)
        && isImage()
        && isUnder5MB();
      allow delete: if isOwner(userId);
    }

    // =========================================================
    // Job attachments (customer uploads for job context)
    // /jobs/{jobId}/attachments/*
    // =========================================================
    match /jobs/{jobId}/attachments/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth()
        && isImage()
        && isUnder5MB();
      allow delete: if false; // Admin only
    }

    // =========================================================
    // Public assets: /public/*  (managed via Admin SDK only)
    // =========================================================
    match /public/{allPaths=**} {
      allow read: if true;   // Public read
      allow write: if false; // Admin SDK only
    }

    // =========================================================
    // Default: deny everything else
    // =========================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
