# =============================================================
# INSTANTATOZ — Environment Variables Template
# =============================================================
# Copy this file to .env.local (for Next.js) or .env (for backend)
# NEVER commit real credentials to version control.
# =============================================================

# -------------------------------------------------------------
# APP CONFIG
# -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Instantatoz
NEXT_PUBLIC_APP_TAGLINE="Find Help. Get Work. Instantly."
NEXT_PUBLIC_APP_URL=https://instantatoz.online
NEXT_PUBLIC_SUPPORT_EMAIL=support@instantatoz.online

# -------------------------------------------------------------
# FIREBASE — Web App Config
# (Get from Firebase Console → Project Settings → Web App)
# -------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Firebase Admin SDK (SERVER SIDE ONLY — never expose to frontend)
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL
FIREBASE_PRIVATE_KEY="YOUR_PRIVATE_KEY"

# -------------------------------------------------------------
# GOOGLE MAPS
# -------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# -------------------------------------------------------------
# PAYMENT GATEWAYS
# (Activate only after merchant onboarding is complete)
# -------------------------------------------------------------

# Razorpay
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
NEXT_PUBLIC_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

# PhonePe
PHONEPE_MERCHANT_ID=YOUR_PHONEPE_MERCHANT_ID
PHONEPE_SALT_KEY=YOUR_PHONEPE_SALT_KEY
PHONEPE_SALT_INDEX=1

# Cashfree
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY

# Payment Mode: TEST or PRODUCTION
PAYMENT_MODE=TEST

# -------------------------------------------------------------
# BACKEND API
# -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001
JWT_SECRET=YOUR_VERY_STRONG_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------
# DATABASE (if using PostgreSQL for financial data)
# -------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/instantatoz

# Redis (for caching, rate limiting, sessions)
REDIS_URL=redis://localhost:6379

# -------------------------------------------------------------
# EMAIL (SMTP)
# -------------------------------------------------------------
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@instantatoz.online
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM="Instantatoz <support@instantatoz.online>"

# -------------------------------------------------------------
# CLOUDINARY (for image optimization if needed)
# -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# -------------------------------------------------------------
# OTP / SMS
# -------------------------------------------------------------
# Use Firebase Phone Auth — no separate SMS provider needed initially
# If custom OTP needed:
SMS_PROVIDER=firebase
# TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
# TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
# TWILIO_PHONE_NUMBER=+1234567890

# -------------------------------------------------------------
# COMMISSION ENGINE
# -------------------------------------------------------------
# Default platform commission percentage (configurable via Admin)
DEFAULT_COMMISSION_PERCENT=20

# -------------------------------------------------------------
# JOB MATCHING
# -------------------------------------------------------------
# Default radius in KM for nearby worker matching
DEFAULT_MATCHING_RADIUS_KM=2

# -------------------------------------------------------------
# APP STORE LINKS (update when apps are published)
# -------------------------------------------------------------
NEXT_PUBLIC_USER_APP_PLAYSTORE_URL=
NEXT_PUBLIC_WORKER_APP_PLAYSTORE_URL=
NEXT_PUBLIC_USER_APP_APPSTORE_URL=
NEXT_PUBLIC_WORKER_APP_APPSTORE_URL=

# -------------------------------------------------------------
# ENVIRONMENT
# -------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_ENV=development
