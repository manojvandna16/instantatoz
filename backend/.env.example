# =============================================================
# Instantatoz NestJS Backend — Environment Variables EXAMPLE
# backend/.env.example
#
# ✅ Safe to commit — contains NO real secrets.
# Copy this to .env and fill in your real values.
# =============================================================

# Server
PORT=4000
NODE_ENV=development

# -------------------------------------------------------
# Firebase Admin SDK
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# -------------------------------------------------------
FIREBASE_PROJECT_ID=instantatoz
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@instantatoz.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# -------------------------------------------------------
# Supabase Storage
# Get from: Supabase Dashboard → Project Settings → API
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to frontend
# -------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=worker-profile-images
