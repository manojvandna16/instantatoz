{
  "expo": {
    "name": "Instantatoz",
    "slug": "instantatoz",
    "version": "1.0.0",
    "scheme": "instantatoz",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d4ed8"
    },
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.instantatoz.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1d4ed8"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Instantatoz uses your location to show nearby available workers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "2535d47a-8f30-4e50-8a75-a6e06b5a2422"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "manojbhatt900"
  }
}
